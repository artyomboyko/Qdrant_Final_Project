# ------------------------------------------------------------
# Local Qdrant
# ------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_TIMEOUT_SECONDS=60
QDRANT_API_KEY=


# ------------------------------------------------------------
# Qdrant Cloud
# ------------------------------------------------------------
QDRANT_CLOUD_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_CLOUD_API_KEY=YOUR_QDRANT_CLOUD_API_KEY


# ------------------------------------------------------------
# Local vLLM service
# ------------------------------------------------------------
VLLM_ROOT_URL=http://vllm-gemma4-12b:8000
VLLM_BASE_URL=http://vllm-gemma4-12b:8000/v1
VLLM_MODEL=gemma-4-12b-it